# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,localhost:8001

# Database
# Leave empty to use Docker Compose defaults (postgresql://postgres:postgres@postgres:5432/postgres)
DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Email (development uses console backend, production uses SMTP)
# Default: console backend in DEBUG=1, SMTP backend in production
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@chantiermobile.com
