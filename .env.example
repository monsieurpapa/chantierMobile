# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,localhost:8001

# Database
# Leave empty to use Docker Compose defaults (postgresql://postgres:postgres@postgres:5432/postgres)
DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CSRF (production: set to your Railway/Render domain, e.g. https://myapp.railway.app)
CSRF_TRUSTED_ORIGINS=

# Email (development uses console backend when DEBUG=1)
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@chantiermobile.com

# Cloudflare R2 — media file storage (required in production, i.e. DEBUG=0)
# Create an R2 API token at dash.cloudflare.com → R2 → Manage API tokens
# CLOUDFARE_R2_TOKEN_NAME  → "Access Key ID" from the R2 API token
# CLOUDFARE_API_TOKEN      → "Secret Access Key" from the R2 API token
# CLOUDFARE_R2_BUCKET_URL  → https://<account-id>.r2.cloudflarestorage.com
CLOUDFARE_R2_TOKEN_NAME=
CLOUDFARE_API_TOKEN=
CLOUDFARE_R2_BUCKET_NAME=chantiermobile-media
CLOUDFARE_R2_BUCKET_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: custom public domain for serving media (leave empty to use R2 bucket URL)
AWS_S3_CUSTOM_DOMAIN=
